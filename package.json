{
  "name": "holicgem",
  "private": true,
  "version": "0.1.0",
  "description": "HOLIC GEM 2.0 - 유저 앱 / 가맹점 모드 / 본사 관리자",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "npm run generate -w @holicgem/db",
    "db:push": "npm run push -w @holicgem/db",
    "db:migrate": "npm run migrate -w @holicgem/db",
    "db:seed": "npm run seed -w @holicgem/db",
    "db:studio": "npm run studio -w @holicgem/db",
    "api": "npm run start:dev -w @holicgem/api",
    "admin": "npm run dev -w @holicgem/admin",
    "mobile": "npm run start -w @holicgem/mobile"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "@nestjs/core@10.4.22": true
  }
}
